{
  "manifest_version": 3,
  "name": "chrome-tab helper",
  "version": "0.5.0",
  "description": "Lets the chrome-tab command open pages in a chosen window and tab group, in the background, and move a tab between windows.",
  "key": "",
  "minimum_chrome_version": "120",
  "permissions": ["tabs", "tabGroups", "nativeMessaging", "alarms"],
  "background": { "service_worker": "background.js" }
}
