#!/usr/bin/env python3
"""
chrome-tab — open pages in a *chosen* Chrome window, quietly.

Why this exists
---------------
`open file.html` (what Claude skills used to do) has three faults on this Mac:
  1. it lands the tab in whichever Chrome window was last used — often an
     unrelated one;
  2. it yanks the frontmost app away from you (`open -g` does NOT fix this —
     Chrome activates itself regardless; measured 2026-08-15);
  3. the tab carries no marker saying which Claude session opened it.

This tool instead drives Chrome's AppleScript interface, which can add a tab to
a *specific* window by id without calling `activate`. Chrome can still raise
itself when a tab's URL is set (measured 2026-08-20 with Slack in front: twice,
the second time ~0.4 s later; measured 2026-09-03 with Terminal in front: not at
all), so a guard thread watches the frontmost app from *before* the navigation
until 1.6 s after it and puts the user's app back within milliseconds each time
Chrome takes it. The rule is: nothing the user is looking at changes — not
their app, not Chrome's window order, not whether a window is minimized, and
(0.5.0) not which tab *any* window is showing. A page always opens in the
background, in its tab group, and waits there; --select, implied by --activate,
is the only way one comes to the front.

Windows are addressed by their **given name** — the label you set with
Chrome's right-click-the-tab-strip > "Name window…". Chrome exposes that as a
read/write `given name` property, so Claude can both read the names you chose
and label windows itself. No opaque window ids in conversation.

Usage
-----
  chrome-tab list [--json]
      Show every Chrome window: given name, tab count, active tab title.

  chrome-tab open <url-or-path>... [options]
      --window NAME    target the window with this given name
      --group NAME     put it in the tab group NAME in that window (needs the helper)
      --new-window     make a fresh window (named via --window) — only when asked
      --activate       bring Chrome forward and show the page (default: stay out
                       of your way)
      --select         show the page in its window, without bringing Chrome forward
      --no-reuse       always add a tab, even if that URL is already open
      --bind           remember this window for the rest of the session

  chrome-tab name <selector> <new-name>
      Give a window a name.  <selector> = window id, list index (#3),
      'front', or an existing given name / title substring.

  chrome-tab bind <NAME> | chrome-tab whoami | chrome-tab unbind
      Manage this session's default window.

  chrome-tab home [NAME]
      Show or set the home window (default "Claude sessions").

  chrome-tab helper install|status|uninstall
      The companion extension. Chrome's AppleScript has no tab groups, can't move a
      tab without destroying it, and asks macOS to raise Chrome on every navigation;
      the extension does those things through the extension API instead.

  chrome-tab where <tab-id>  |  chrome-tab move <tab-id> --window NAME
      Which window holds a tab; move a tab into a named window (needs the helper —
      AppleScript's move closes the tab and opens a blank one).

  chrome-tab hook claude-in-chrome
      A PostToolUse hook (scripts/install-cic-hook.py registers it). When a
      Claude-in-Chrome tool reports a brand-new one-tab session group, it moves that
      group into the browse window (default "Claude sessions"), once.

  chrome-tab doctor [--quiet]
      Check what otherwise fails silently: a PATH entry left pointing at an old
      plugin version, PyObjC missing for this python, ~/.local/bin not on PATH.

Resolution order for the target window:
  --window  >  $CLAUDE_CHROME_WINDOW  >  session binding  >  the home window.

A name that matches no open window does not create one. Until 0.2.0 it did, so every
session that invented a topic name opened a brand-new window. The page goes to the
home window instead and the tool says so. Only --new-window creates a window,
plus the home window itself on the rare run when it isn't open.

With the helper running, every page lands in a tab group (0.4.0). The topic comes from
--group, else the --window name given on this call, else the group this session used
before, else the file's project folder, else the current folder. It is matched loosely
against the groups in every window ("mail archive" → "Mail archive", "Furniture" →
"Furnitures"); a match wins wherever it lives, otherwise a new group is made in the home
window. Claude-in-Chrome's own groups ("Claude", "✅Claude") are never matched or added to.
"""

import argparse
import json
import os
import re
import shutil
import socket
import subprocess
import sys
import threading
import time
import urllib.parse
from pathlib import Path

US = "\x1f"  # unit separator between fields
RS = "\x1e"  # record separator between windows

STATE_DIR = Path(os.environ.get("CHROME_TAB_STATE_DIR") or (Path.home() / ".claude" / "chrome-sessions"))
SESSION_ID = os.environ.get("CLAUDE_CODE_SESSION_ID") or os.environ.get(
    "CLAUDE_SESSION_ID"
) or "no-session"

CHROME_BID = "com.google.Chrome"

__version__ = "0.5.0"

# A PATH entry written by install.sh from a plugin cache starts with this line.
LAUNCHER_MARK = "chrome-tab launcher (written by install.sh)"


# ------------------------------------------------- which copy of me is installed?
#
# Claude Code installs a plugin into a *versioned* directory,
# ~/.claude/plugins/cache/<marketplace>/chrome-tab/<version>/, and `claude plugin
# update` makes a new one next to it. A PATH symlink into the old directory keeps
# running the old copy while the update reports success — that happened to Tony
# (2026-09-15): 0.1.2 sat unused for two weeks. install.sh now writes a launcher
# that resolves the installed copy at run time; the helpers below are that
# resolution, and `forward_if_stale()` is the same rescue for a PATH entry made
# the old way.


def claude_dir():
    """Claude Code's config dir (honours CLAUDE_CONFIG_DIR like the CLI does)."""
    return Path(os.environ.get("CLAUDE_CONFIG_DIR") or (Path.home() / ".claude"))


PLUGIN_REL = Path("skills") / "chrome-tab" / "scripts" / "chrome-tab"
IN_PLUGIN_CACHE = re.compile(r"/plugins/cache/[^/]+/chrome-tab/[^/]+/")


def version_of(path):
    """The __version__ inside another copy of this script, or None."""
    try:
        m = re.search(r'^__version__ = "([^"]+)"', Path(path).read_text(errors="ignore"), re.M)
        return m.group(1) if m else None
    except Exception:
        return None


def _version_dir_key(d):
    """Sort key for a plugin-cache version directory: dotted numbers, then mtime."""
    nums = tuple(int(x) for x in d.name.split(".")) if re.fullmatch(r"\d+(\.\d+)*", d.name) else ()
    try:
        mtime = d.stat().st_mtime
    except OSError:
        mtime = 0.0
    return (nums, mtime)


def installed_copy():
    """The chrome-tab script of the plugin version Claude Code has installed, or None.

    installed_plugins.json is what `claude plugin list` reads, so it is the source of
    truth; if it is missing or unreadable, the highest non-orphaned version directory
    in the cache stands in. None means no plugin copy exists at all — this is a
    source checkout such as ~/.claude/skills.
    """
    try:
        data = json.loads((claude_dir() / "plugins" / "installed_plugins.json").read_text())
        plugins = data.get("plugins", data) if isinstance(data, dict) else {}
        for key, entries in plugins.items():
            if key.split("@", 1)[0] != "chrome-tab":
                continue
            for e in entries if isinstance(entries, list) else [entries]:
                ip = e.get("installPath") if isinstance(e, dict) else None
                if ip and (Path(ip) / PLUGIN_REL).exists():
                    return Path(ip) / PLUGIN_REL
    except Exception:
        pass
    cands = list((claude_dir() / "plugins" / "cache").glob("*/chrome-tab/*/" + PLUGIN_REL.as_posix()))
    live = [c for c in cands if not (c.parents[3] / ".orphaned_at").exists()]
    cands = live or cands
    return max(cands, key=lambda c: _version_dir_key(c.parents[3])) if cands else None


def forward_if_stale():
    """A plugin-cache copy that is not the installed one hands over to the installed one."""
    if os.environ.get("CHROME_TAB_NO_FORWARD"):
        return
    me = Path(__file__).resolve()
    if not IN_PLUGIN_CACHE.search(me.as_posix()):
        return                                   # a source checkout is authoritative
    target = installed_copy()
    if target is None or target.resolve() == me:
        return
    print(f"chrome-tab: this is {version_of(me) or '?'} at {me}, but the installed plugin is "
          f"{version_of(target) or '?'} — running that instead. The command on your PATH is stale; "
          f"make it current once with:  sh \"{target.parent / 'install.sh'}\"",
          file=sys.stderr)
    os.execve(sys.executable, [sys.executable, str(target), *sys.argv[1:]],
              dict(os.environ, CHROME_TAB_NO_FORWARD="1"))


def pip_hint():
    """The command that gives *this* interpreter PyObjC (Homebrew's needs the override flag)."""
    import sysconfig
    managed = (Path(sysconfig.get_path("stdlib")) / "EXTERNALLY-MANAGED").exists()
    flag = " --break-system-packages" if managed else ""
    return f"{sys.executable} -m pip install --user{flag} pyobjc-framework-Cocoa"


def slow_path_note():
    """One line for `open` when the focus guard had to run without PyObjC, else None."""
    if _appkit():
        return None
    return (f"note: PyObjC is not installed for {sys.executable}, so the focus guard polled "
            f"every 50 ms with lsappinfo + open -b instead of every 3 ms — a jump can show "
            f"for a frame or two. Fix:  {pip_hint()}")


# ----------------------------------------------------------------- AppleScript


def osa(script, *args):
    """Run an AppleScript, passing args as argv. Returns stdout stripped."""
    if os.environ.get("CHROME_TAB_NO_APPLESCRIPT"):
        # Tests against a throwaway browser set this, so nothing can reach the user's Chrome.
        die("AppleScript is disabled (CHROME_TAB_NO_APPLESCRIPT is set)")
    proc = subprocess.run(
        ["osascript", "-", *[str(a) for a in args]],
        input=script,
        capture_output=True,
        text=True,
    )
    if proc.returncode != 0:
        err = proc.stderr.strip()
        if "-600" in err or "not running" in err.lower():
            die("Google Chrome is not running.")
        die(f"AppleScript failed: {err}")
    return proc.stdout.rstrip("\n")


def die(msg, code=1):
    print(f"chrome-tab: {msg}", file=sys.stderr)
    sys.exit(code)


# NOTE: `repeat with w in windows` re-resolves the live window collection on
# every iteration. With a heavy-tab user actively clicking between windows,
# Chrome reorders mid-loop and you get duplicated/misaligned rows (observed
# 2026-08-15). Bulk accessors (`id of every window`) snapshot in one shot.
LIST_SCRIPT = f"""
on run argv
  tell application "Google Chrome"
    set idList to id of every window
    set gnList to given name of every window
    set nmList to name of every window
    set mnList to minimized of every window
    set n to count of idList
    set out to ""
    repeat with i from 1 to n
      set tc to 0
      try
        set tc to count of tabs of window i
      end try
      set out to out & (item i of idList as text) & "{US}" & (item i of gnList) & "{US}" & ¬
        (tc as text) & "{US}" & (item i of mnList as text) & "{US}" & ¬
        (item i of nmList) & "{RS}"
    end repeat
    return out
  end tell
end run
"""


# Reading a Chrome addressed by process id. `tell application "Google Chrome"` goes by
# bundle id, so while another job runs a headless copy of the Chrome app, that copy can
# answer instead (observed 2026-09-16: 0 windows listed, windows "created" invisibly).
# The helper's host knows the pid of the Chrome that runs the extension; reads go there.
JXA_LIST = """
function run(argv) {
  const ws = Application(Number(argv[0])).windows;
  const ids = ws.id(), names = ws.givenName(), mins = ws.minimized(), titles = ws.name();
  const counts = ws.tabs.id().map(a => a.length);
  return JSON.stringify(ids.map((id, i) => ({id: String(id), given_name: names[i] || "",
    minimized: !!mins[i], title: titles[i] || "", tabs: counts[i]})));
}
"""

JXA_NAME = """
function run(argv) {
  Application(Number(argv[0])).windows.byId(Number(argv[1])).givenName = argv[2];
  return "ok";
}
"""


def jxa(script, *args):
    proc = subprocess.run(["osascript", "-l", "JavaScript", "-", *[str(a) for a in args]],
                          input=script, capture_output=True, text=True)
    if proc.returncode != 0:
        raise RuntimeError(proc.stderr.strip())
    return proc.stdout.rstrip("\n")


def list_windows(pid=None):
    """Chrome's windows, front to back. With `pid`, read that Chrome process only."""
    if pid:
        try:
            rows = json.loads(jxa(JXA_LIST, pid))
            return [dict(r, index=i) for i, r in enumerate(rows, start=1)]
        except Exception:
            pass                      # fall through to the bundle-id read
    raw = osa(LIST_SCRIPT)
    out = []
    for i, rec in enumerate([r for r in raw.split(RS) if r.strip()], start=1):
        parts = rec.split(US)
        if len(parts) < 5:
            continue
        wid, given, count, minimized, title = parts[0], parts[1], parts[2], parts[3], parts[4]
        out.append(
            {
                "index": i,
                "id": wid.strip(),
                "given_name": given.strip(),
                "tabs": int(count) if count.strip().isdigit() else 0,
                "minimized": minimized.strip().lower() == "true",
                "title": title.strip(),
            }
        )
    return out


# --------------------------------------------------------------- window lookup


def resolve_window(selector, windows=None, titles=True):
    """Resolve a human selector to a window dict, or None.

    `titles=False` stops before the last-resort match on an unnamed window's active
    tab title — `open` uses that, so a topic word can't land a page in whatever
    unnamed window happens to be showing a page with that word in its title.
    """
    if not selector:
        return None
    windows = windows if windows is not None else list_windows()
    s = selector.strip()

    # explicit list index  (#3 or 3)
    m = re.fullmatch(r"#?(\d{1,2})", s)
    if m:
        idx = int(m.group(1))
        for w in windows:
            if w["index"] == idx:
                return w

    # raw window id (Chrome ids are long integers)
    for w in windows:
        if w["id"] == s:
            return w

    if s.lower() == "front":
        return windows[0] if windows else None

    # exact given name
    for w in windows:
        if w["given_name"] == s:
            return w
    # case-insensitive given name
    for w in windows:
        if w["given_name"].lower() == s.lower():
            return w
    # substring of given name
    for w in windows:
        if w["given_name"] and s.lower() in w["given_name"].lower():
            return w
    if not titles:
        return None
    # substring of active tab title (last resort)
    for w in windows:
        if s.lower() in w["title"].lower():
            return w
    return None


# ------------------------------------------------------------------ focus care

# PyObjC (ships with Anaconda/Homebrew Python, not with Apple's) gives instant
# front-app reads and an in-process re-activation call. Without it the guard
# below falls back to `lsappinfo` + `open -b`, which works but is ~30× slower
# to notice and ~10× slower to put things back. Imported lazily: it costs a few
# hundred ms and `chrome-tab list` doesn't need it.
_APPKIT = None


def _appkit():
    global _APPKIT
    if _APPKIT is None:
        try:
            import AppKit  # type: ignore
            import objc  # type: ignore
            _APPKIT = (AppKit, objc)
        except Exception:
            _APPKIT = False
    return _APPKIT


def front_app():
    """(name, bundleid, pid) of the frontmost app, without needing Accessibility."""
    ak = _appkit()
    if ak:
        try:
            a = ak[0].NSWorkspace.sharedWorkspace().frontmostApplication()
            if a is not None:
                return (str(a.localizedName()), str(a.bundleIdentifier() or ""),
                        int(a.processIdentifier()))
        except Exception:
            pass
    try:
        asn = subprocess.run(
            ["lsappinfo", "front"], capture_output=True, text=True
        ).stdout.strip()
        if not asn:
            return (None, None, None)
        info = subprocess.run(
            ["lsappinfo", "info", "-only", "name,bundleid,pid", asn],
            capture_output=True,
            text=True,
        ).stdout
        name = re.search(r'"LSDisplayName"="([^"]*)"', info)
        bid = re.search(r'"CFBundleIdentifier"="([^"]*)"', info)
        pid = re.search(r'"?pid"?\s*=\s*(\d+)', info)
        return (name.group(1) if name else None, bid.group(1) if bid else None,
                int(pid.group(1)) if pid else None)
    except Exception:
        return (None, None, None)


class FocusGuard:
    """Keep the user's app in front while Chrome is told to navigate.

    Chrome's AppleScript `set URL` can activate Chrome — measured 2026-08-20
    (Slack in front, user idle): immediately, and again ~0.4 s later when the
    navigation commits. Start the guard *before* the navigation call. It polls
    the frontmost app on a thread and, the moment Chrome shows up there, puts
    the user's app back: with PyObjC that is a ~3 ms poll and an in-process
    `activateWithOptions:`; the fallback polls `lsappinfo` every 50 ms and
    runs `open -b`. If the AppKit request is not honoured (macOS 14+ can decline
    activation requests from bystanders) the guard notices within 250 ms and
    switches to `open -b` for the rest of the run.

    Call `done()` after the last navigation; the guard keeps watching for
    `tail` seconds more and then reports every interval Chrome was in front
    (`spans`). The tail exists for the delayed second activation; 1.6 s covers
    the measured 0.4 s with margin. When the user is already in Chrome there is
    nothing to guard at the app level — window order is the caller's job.
    """

    def __init__(self, enabled=True, tail=1.6):
        self.name, self.bid, self.pid = front_app()
        self.tail = tail
        self.enabled = (enabled and bool(self.bid) and self.bid != CHROME_BID
                        and self.bid != "com.apple.loginwindow")
        self.spans = []
        self._app = None
        self.method = "open"
        ak = _appkit()
        if ak and self.pid:
            try:
                self._app = ak[0].NSRunningApplication.runningApplicationWithProcessIdentifier_(
                    self.pid)
                if self._app is not None:
                    self.method = "activate"
            except Exception:
                self._app = None
        self._stop_at = None
        self._thread = None

    def __enter__(self):
        if self.enabled:
            self._thread = threading.Thread(target=self._run, daemon=True)
            self._thread.start()
        return self

    def done(self, tail=None):
        """The last navigation call has returned; watch `tail` more seconds."""
        self._stop_at = time.monotonic() + (self.tail if tail is None else tail)

    def __exit__(self, *exc):
        if self._stop_at is None:
            self.done()
        if self._thread:
            self._thread.join(timeout=self.tail + 3)

    def _restore(self):
        if self.method == "activate":
            try:
                ak = _appkit()
                self._app.activateWithOptions_(ak[0].NSApplicationActivateIgnoringOtherApps)
                return
            except Exception:
                self.method = "open"
        subprocess.Popen(["open", "-b", self.bid],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    def _run(self):
        ak = _appkit()
        if ak:
            try:
                with ak[1].autorelease_pool():
                    self._loop(0.003)
                return
            except Exception:
                pass
        self._loop(0.05)

    def _loop(self, step):
        t0 = time.monotonic()
        since = None
        last_fix = 0.0
        while True:
            now = time.monotonic()
            if front_app()[1] == CHROME_BID:
                if since is None:
                    since = now
                if now - last_fix > 0.04:
                    if self.method == "activate" and now - since > 0.25:
                        self.method = "open"      # the polite request is being ignored
                    self._restore()
                    last_fix = now
            elif since is not None:
                self.spans.append((since - t0, now - t0))
                since = None
            if self._stop_at is not None and now >= self._stop_at:
                break
            time.sleep(step)
        if since is not None:
            self.spans.append((since - t0, time.monotonic() - t0))

    def describe(self):
        """One line for the report: what Chrome did and what the guard did about it."""
        if not self.enabled:
            return None
        if not self.spans:
            return "Chrome never came forward"
        ms = ", ".join(f"{(b - a) * 1000:.0f} ms" for a, b in self.spans)
        how = "AppKit activate" if self.method == "activate" else "open -b"
        return (f"Chrome came forward {len(self.spans)}× (for {ms}); "
                f"put you back each time via {how}")


# ------------------------------------------------------------------- tab logic


def to_url(target):
    """Turn a file path into a properly-encoded file:// URL; pass URLs through."""
    if re.match(r"^[a-zA-Z][a-zA-Z0-9+.-]*://", target):
        return target
    if target.startswith("about:") or target.startswith("chrome:"):
        return target
    p = Path(target).expanduser()
    if p.exists() or target.startswith((".", "/", "~")):
        abs_path = str(p.resolve())
        return "file://" + urllib.parse.quote(abs_path, safe="/")
    # bare domain like example.com
    if "." in target and " " not in target:
        return "https://" + target
    return target


CREATE_SCRIPT = """
on run argv
  set winName to item 1 of argv
  set theURL to item 2 of argv
  tell application "Google Chrome"
    set w to make new window
    if winName is not "" then set given name of w to winName
    set URL of active tab of w to theURL
    return id of w as text
  end tell
end run
"""

ADD_SCRIPT = """
on run argv
  set winID to item 1 of argv
  set theURL to item 2 of argv
  tell application "Google Chrome"
    set w to missing value
    repeat with ww in windows
      if (id of ww as text) is winID then
        set w to ww
        exit repeat
      end if
    end repeat
    if w is missing value then return "ERR:nowindow"
    make new tab at end of tabs of w with properties {URL:theURL}
    return "added:" & ((count of tabs of w) as text)
  end tell
end run
"""

# Locate an already-open copy of this URL and report whether it is the tab the
# window is currently showing. Combined with "is this window Chrome's front
# window" and "is Chrome the frontmost app", that tells us whether the user is
# looking at this page right now — in which case reloading it under him is rude.
FIND_TAB_SCRIPT = """
on run argv
  set winID to item 1 of argv
  set theURL to item 2 of argv
  tell application "Google Chrome"
    repeat with ww in windows
      if (id of ww as text) is winID then
        set ai to active tab index of ww
        set n to count of tabs of ww
        repeat with i from 1 to n
          set u to URL of tab i of ww
          if u is theURL or u starts with (theURL & "#") then
            return (i as text) & "|" & (ai as text)
          end if
        end repeat
        return "0|" & (ai as text)
      end if
    end repeat
    return "ERR:nowindow"
  end tell
end run
"""

RELOAD_SCRIPT = """
on run argv
  set winID to item 1 of argv
  set tabIdx to (item 2 of argv) as integer
  set doSelect to (item 3 of argv is "1")
  tell application "Google Chrome"
    repeat with ww in windows
      if (id of ww as text) is winID then
        tell tab tabIdx of ww to reload
        if doSelect then set active tab index of ww to tabIdx
        return "ok"
      end if
    end repeat
    return "ERR:nowindow"
  end tell
end run
"""

# Switching the active tab of a window is silent (no activation, no raise), so
# this is how a new tab is put *behind* the one the user is reading.
SELECT_TAB_SCRIPT = """
on run argv
  set winID to item 1 of argv
  set tabIdx to (item 2 of argv) as integer
  tell application "Google Chrome"
    repeat with ww in windows
      if (id of ww as text) is winID then
        if tabIdx is greater than or equal to 1 and tabIdx is less than or equal to (count of tabs of ww) then
          set active tab index of ww to tabIdx
        end if
        return "ok"
      end if
    end repeat
    return "ERR:nowindow"
  end tell
end run
"""

NAME_SCRIPT = """
on run argv
  set winID to item 1 of argv
  set newName to item 2 of argv
  tell application "Google Chrome"
    repeat with ww in windows
      if (id of ww as text) is winID then
        set given name of ww to newName
        return "ok"
      end if
    end repeat
    return "ERR:nowindow"
  end tell
end run
"""

ACTIVATE_SCRIPT = """
on run argv
  set winID to item 1 of argv
  tell application "Google Chrome"
    activate
    repeat with ww in windows
      if (id of ww as text) is winID then
        set index of ww to 1
        return "ok"
      end if
    end repeat
  end tell
end run
"""

# Setting a tab's URL makes Chrome show that window, which raises it inside
# Chrome. This puts the window the user was actually looking at back on top
# *without* calling activate — verified to work on Chrome/macOS 2026-08-15.
RAISE_SCRIPT = """
on run argv
  set winID to item 1 of argv
  tell application "Google Chrome"
    repeat with ww in windows
      if (id of ww as text) is winID then
        set index of ww to 1
        return "ok"
      end if
    end repeat
    return "gone"
  end tell
end run
"""

FRONT_WIN_SCRIPT = """
tell application "Google Chrome"
  if (count of windows) is 0 then return ""
  return (id of front window) as text
end tell
"""

# The same show-the-window step de-minimizes a minimized target (measured
# 2026-09-03: `minimized` went true → false on a tab add). Put it back so the
# user's arrangement is as they left it.
MINIMIZE_SCRIPT = """
on run argv
  set winID to item 1 of argv
  tell application "Google Chrome"
    repeat with ww in windows
      if (id of ww as text) is winID then
        set minimized of ww to true
        return "ok"
      end if
    end repeat
    return "gone"
  end tell
end run
"""


# ------------------------------------------------------------------- helper
#
# The companion extension (helper/extension) and its native-messaging host
# (helper/chrome_tab_host.py). `chrome-tab helper install` copies both to a stable
# directory, so a branch switch or plugin update can't pull them out from under Chrome,
# and registers the host with Chrome. The extension is loaded once by hand
# (chrome://extensions → Developer mode → Load unpacked); Chrome then starts the host,
# which serves a Unix socket that only this user can open. When the helper isn't
# running, everything falls back to AppleScript and says what it couldn't do.

HELPER_NAME = "com.jacob_skills.chrome_tab"
HELPER_EXT_ID = "fjfhflgjjbjjlkbfhjegbnbommoiffie"   # fixed by the "key" in manifest.json
HELPER_SRC = Path(__file__).resolve().parent.parent / "helper"


def helper_dir():
    return Path(os.environ.get("CHROME_TAB_HELPER_DIR")
                or (Path.home() / ".claude" / "chrome-tab-helper"))


def helper_socket():
    return Path(os.environ.get("CHROME_TAB_SOCKET") or (helper_dir() / "bridge.sock"))


def nmh_dir():
    return Path(os.environ.get("CHROME_TAB_NMH_DIR") or (
        Path.home() / "Library" / "Application Support" / "Google" / "Chrome" / "NativeMessagingHosts"))


class HelperError(Exception):
    pass


def helper_call(cmd, timeout=8.0, **args):
    """Ask the helper to do `cmd`. None when it isn't running; HelperError when it refused."""
    path = helper_socket()
    if not path.exists():
        return None
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.settimeout(timeout + 2)
    buf = b""
    try:
        s.connect(str(path))
        s.sendall((json.dumps({"cmd": cmd, "args": args, "timeout": timeout}) + "\n").encode())
        while not buf.endswith(b"\n"):
            chunk = s.recv(65536)
            if not chunk:
                break
            buf += chunk
    except OSError:
        return None
    finally:
        s.close()
    if not buf.strip():
        return None                   # the host went away mid-request (it dies with its Chrome)
    try:
        reply = json.loads(buf.decode())
    except ValueError:
        return None
    if not reply.get("ok"):
        raise HelperError(reply.get("error") or "no reply")
    return reply.get("result")


def helper_host():
    """The running host's facts (pid, chrome_pid, extension), or None."""
    try:
        return helper_call("host", timeout=2)
    except HelperError:
        return None


def name_window(wid, name, chrome_pid=None):
    res = osa(NAME_SCRIPT, wid, name)
    if res.startswith("ERR") and chrome_pid:
        try:
            jxa(JXA_NAME, chrome_pid, wid, name)      # the bundle-id route hit another Chrome
        except Exception:
            pass


# ------------------------------------------------------------ session bindings


def binding_file(session=None):
    return STATE_DIR / f"{session or SESSION_ID}.json"


def read_binding(session=None):
    f = binding_file(session)
    if f.exists():
        try:
            return json.loads(f.read_text())
        except Exception:
            return None
    return None


def write_binding(name, group=None):
    """Remember this session's window and tab group (the next open without flags reuses them)."""
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    binding_file().write_text(json.dumps({"session": SESSION_ID, "window_name": name, "group": group,
                                          "cwd": os.getcwd()}, indent=2))


# ----------------------------------------------------------------- home window
#
# Where a page goes when nobody named a window, or the name matches no open
# window. One window the user keeps, instead of a new one per topic.

DEFAULT_HOME = "Claude sessions"


def config_file():
    base = os.environ.get("XDG_CONFIG_HOME") or (Path.home() / ".config")
    return Path(base) / "chrome-tab" / "config.json"


def read_config():
    try:
        data = json.loads(config_file().read_text())
        return data if isinstance(data, dict) else {}
    except Exception:
        return {}


def home_window_name():
    env = os.environ.get("CHROME_TAB_HOME_WINDOW", "").strip()
    if env:
        return env
    v = read_config().get("home_window")
    return v.strip() if isinstance(v, str) and v.strip() else DEFAULT_HOME


# ------------------------------------------------------------------ tab groups
#
# The user's ideal (2026-09-17): every page a session opens goes into the matching tab
# group if one exists, else into a new, well-named group in the home window; never loose.
# The tool does the matching so nothing depends on a session remembering a rule.

# Claude-in-Chrome titles its session groups "Claude" (legacy "Claude (MCP)", side panel
# "⌛/🔔/✅Claude"). Adding a page to one breaks that browsing session, so they never match.
CIC_GROUP = re.compile(r"^\s*[⌛🔔✅]?\s*Claude(\s*\(MCP\))?\s*$")
FLAG_SUFFIX = re.compile(r"\s*[\(\[]claude[\)\]]\s*$", re.I)
GENERIC_FOLDERS = {"", "/", "claude", "reports", "session", "tmp", "scripts", "output"}


def norm_words(s):
    return re.sub(r"[^a-z0-9 ]+", " ", (s or "").lower()).split()


def group_score(name, title):
    """2 = the same name (case and punctuation aside); 1 = a loose match; 0 = no.

    Loose: every word of the shorter name, four letters or more, starts a word of the
    longer one (or vice versa), so "mail archive" ⇒ "Mail archive", "Furniture" ⇒
    "Furnitures", "UChicago mail archive" ⇒ "Mail archive", but "Berkeley seminars" never
    lands in "Berkeley funding" and "FE" only ever matches "FE".
    """
    if CIC_GROUP.match(title or "") or CIC_GROUP.match(name or ""):
        return 0
    a, b = norm_words(name), norm_words(title)
    if not a or not b:
        return 0
    if a == b:
        return 2
    short, long_ = (a, b) if len(a) <= len(b) else (b, a)
    if all(len(t) >= 4 and any(len(u) >= 4 and (u.startswith(t) or t.startswith(u)) for u in long_)
           for t in short):
        return 1
    return 0


def find_group(topic, ext_windows, prefer=()):
    """The best existing group for `topic`: (window_id, title, score) or None.

    `ext_windows` is the helper's window list (each with "groups"). Ties go to the windows
    in `prefer` (ids, in order), then to the first window Chrome lists.
    """
    best = None
    order = {str(w): i for i, w in enumerate(prefer)}
    for wi, w in enumerate(ext_windows or []):
        for g in w.get("groups") or []:
            sc = group_score(topic, g.get("title", ""))
            if not sc:
                continue
            key = (-sc, order.get(str(w["id"]), len(order)), wi)
            if best is None or key < best[0]:
                best = (key, (str(w["id"]), g["title"], sc))
    return best[1] if best else None


def project_of(target, home=None):
    """A topic name from where a file lives, or None for URLs and unhelpful folders.

    `<project>/reports (claude)/x.html` → project; `~/Claude/reports/<topic>/x.html` → topic;
    otherwise the file's folder, minus a "(claude)" flag.
    """
    if not target or re.match(r"^[a-zA-Z][a-zA-Z0-9+.-]*:", target) and not target.startswith("file:"):
        return None
    if target.startswith("file://"):
        target = urllib.parse.unquote(target[7:])
    p = Path(target).expanduser()
    try:
        parts = p.resolve().parts
    except Exception:
        return None
    home = Path(home or Path.home())
    name = None
    if "reports (claude)" in parts:
        i = parts.index("reports (claude)")
        name = parts[i - 1] if i > 0 else None
    else:
        central = (home / "Claude" / "reports").parts
        if parts[:len(central)] == central and len(parts) > len(central) + 1:
            name = parts[len(central)]
        else:
            name = p.parent.name
    name = FLAG_SUFFIX.sub("", name or "").strip()
    return name if name.lower() not in GENERIC_FOLDERS else None


def topic_name(explicit, remembered, wanted, fell_back, targets, cwd=None):
    """(topic, where it came from).

    What the session says on this call (--group, then --window) beats what it used before:
    a session that names a new topic must not stay stuck in its first group. Memory covers
    the opens with no hints at all; the file's folder and the current folder come last.
    """
    if explicit and explicit.strip():
        return explicit.strip(), "--group"
    if wanted and wanted.strip():
        return wanted.strip(), "the window name you gave" if fell_back else "the window's name"
    if remembered:
        return remembered, "this session's earlier group"
    for t in targets or []:
        name = project_of(t)
        if name:
            return name, "the file's folder"
    folder = FLAG_SUFFIX.sub("", Path(cwd or os.getcwd()).name).strip()
    if folder.lower() not in GENERIC_FOLDERS:
        return folder, "the current folder"
    return "Claude pages", "the default"


def plan_placement(windows, ext, wanted, explicit_group, binding, targets, home,
                   new_window=False, cwd=None):
    """Where a page goes, without touching Chrome.

    windows  Chrome's windows (chrome-tab's list, with given names); ext the helper's list
             (with groups) or None when the helper isn't running.
    Returns a dict: window (open window or None), create_name (a window to make),
    topic, topic_source, group (title to use; None without the helper), group_new,
    fell_back (the --window name matched nothing), followed (a group in another window
    won), others (group titles already in the chosen window).
    """
    binding = binding or {}
    remembered = binding.get("group")
    target = None
    fell_back = False
    if new_window:
        target, create_name = None, wanted
    elif wanted:
        target = resolve_window(wanted, windows, titles=False)
        fell_back = target is None
        create_name = None
    else:
        create_name = None
    # An explicit window that isn't the one the session used before makes the earlier
    # group irrelevant: "--window FE" after pages in "chrome-tab" means FE, not chrome-tab.
    if target is not None and remembered and (binding.get("window_name") or "").lower() != \
            (target.get("given_name") or "").lower():
        remembered = None
    topic, source = topic_name(explicit_group, remembered, wanted, fell_back, targets, cwd)

    home_w = next((w for w in windows if w["given_name"].lower() == (home or "").lower()), None)
    plan = {"topic": topic, "topic_source": source, "fell_back": fell_back, "followed": False,
            "group": None, "group_new": False, "others": [], "create_name": None, "window": None}
    if new_window:
        plan.update(window=None, create_name=create_name, group=topic if ext is not None else None,
                    group_new=ext is not None)
        return plan
    if ext is None:                                   # no helper: window only, no groups
        plan.update(window=target or home_w, create_name=None if (target or home_w) else home)
        return plan
    by_id = {str(w["id"]): w for w in ext}
    if target is not None:
        pool = [by_id[target["id"]]] if target["id"] in by_id else []
    else:
        pool = ext
    prefer = [home_w["id"]] if home_w else []
    prev = next((w["id"] for w in windows
                 if w["given_name"] and w["given_name"].lower() == (binding.get("window_name") or "").lower()), None)
    if prev:
        prefer.append(prev)
    hit = find_group(topic, pool, prefer)
    if hit:
        wid, title, _ = hit
        win = next((w for w in windows if w["id"] == wid), None)
        plan.update(window=win, group=title,
                    followed=(target is None and (home_w is None or wid != home_w["id"])))
    else:
        win = target or home_w
        plan.update(window=win, create_name=None if win else home, group=topic, group_new=True)
    if plan["window"] is not None:
        plan["others"] = [g["title"] for g in (by_id.get(plan["window"]["id"], {}).get("groups") or [])
                          if g["title"] != plan["group"]]
    return plan


# ----------------------------------------------------------------- subcommands


def cmd_list(args):
    host = helper_host()
    windows = list_windows(host.get("chrome_pid") if host else None)
    ext = {}
    if host:
        try:
            ext = {str(w["id"]): w for w in (helper_call("windows") or [])}
        except HelperError:
            ext = {}
    if args.json:
        for w in windows:
            w["groups"] = ext.get(w["id"], {}).get("groups") if host else None
        print(json.dumps(windows, indent=2))
        return
    if not windows:
        print("No Chrome windows open.")
        return
    b = read_binding()
    bound = b.get("window_name") if b else None
    name_w = max([len(w["given_name"]) for w in windows] + [11])
    print(f"{'#':>2}  {'given name'.ljust(name_w)}  {'tabs':>4}  active tab")
    print(f"{'':>2}  {'-' * name_w}  {'----':>4}  {'-' * 46}")
    for w in windows:
        given = w["given_name"] or "—"
        mark = " ←bound" if bound and w["given_name"] == bound else ""
        mini = " [minimized]" if w["minimized"] else ""
        title = w["title"][:46]
        print(f"{w['index']:>2}  {given.ljust(name_w)}  {w['tabs']:>4}  {title}{mini}{mark}")
        groups = ext.get(w["id"], {}).get("groups") or []
        if groups:
            print(f"{'':>2}  {'':{name_w}}        groups: " + ", ".join(
                f"{g['title'] or '(untitled)'} ({g['tabs']})" for g in groups))
    if not host:
        print("\n(tab groups aren't shown: the chrome-tab helper isn't running — chrome-tab helper status)")
    unnamed = [w for w in windows if not w["given_name"]]
    if unnamed:
        print(
            f"\n{len(unnamed)} window(s) have no given name. "
            f"Name one with:  chrome-tab name '#<n>' 'Some Name'"
        )


def cmd_name(args):
    w = resolve_window(args.selector)
    if not w:
        die(f"no window matches {args.selector!r}. Try: chrome-tab list")
    res = osa(NAME_SCRIPT, w["id"], args.new_name)
    if res.startswith("ERR"):
        die(f"could not name window ({res})")
    print(f"Window #{w['index']} is now named: {args.new_name}")


def cmd_bind(args):
    write_binding(args.name)
    print(f"Session bound to Chrome window: {args.name}")


def cmd_unbind(args):
    f = binding_file()
    if f.exists():
        f.unlink()
        print("Session binding removed.")
    else:
        print("No binding for this session.")


def cmd_whoami(args):
    b = read_binding()
    print(f"session: {SESSION_ID}")
    home = home_window_name()
    if b:
        w = resolve_window(b["window_name"], titles=False)
        state = "exists" if w else f"not open — pages go to the home window “{home}”"
        print(f"window : {b['window_name']}  [{state}]")
        if b.get("group"):
            print(f"group  : {b['group']}  (the next open without --group reuses it)")
    else:
        print(f"window : (unbound) — pages go to the home window “{home}”")


def cmd_home(args):
    if args.name is None:
        src = ("$CHROME_TAB_HOME_WINDOW" if os.environ.get("CHROME_TAB_HOME_WINDOW", "").strip()
               else str(config_file()) if read_config().get("home_window") else "default")
        print(f"home window: {home_window_name()}  ({src})")
        return
    cfg = read_config()
    cfg["home_window"] = args.name.strip()
    config_file().parent.mkdir(parents=True, exist_ok=True)
    config_file().write_text(json.dumps(cfg, indent=2) + "\n")
    print(f"home window set to “{cfg['home_window']}” ({config_file()})")


def helper_manifest_path():
    return nmh_dir() / f"{HELPER_NAME}.json"


LAUNCHER_HEAD = "# chrome-tab helper host launcher (written by chrome-tab helper install)"


def helper_install(args):
    src = HELPER_SRC
    if not (src / "extension" / "manifest.json").exists() or not (src / "chrome_tab_host.py").exists():
        die(f"helper sources not found in {src}")
    d = helper_dir()
    d.mkdir(parents=True, exist_ok=True)
    os.chmod(d, 0o700)
    # Chrome loads the extension from here, not from the source checkout, so switching
    # branches or updating the plugin can't pull files out from under it.
    staged = d / "extension.new"
    if staged.exists():
        shutil.rmtree(staged)
    shutil.copytree(src / "extension", staged)
    if (d / "extension").exists():
        shutil.rmtree(d / "extension")
    staged.rename(d / "extension")
    shutil.copy2(src / "chrome_tab_host.py", d / "chrome_tab_host.py")
    launcher = d / "host"
    launcher.write_text(
        "#!/bin/sh\n" + LAUNCHER_HEAD + "\n"
        "# exec keeps Chrome as the host's parent: that is how it learns which Chrome runs it.\n"
        f'CHROME_TAB_SOCKET="{helper_socket()}" exec "{sys.executable}" '
        f'"{d / "chrome_tab_host.py"}" "$@"\n')
    launcher.chmod(0o755)
    manifest = {
        "name": HELPER_NAME,
        "description": "chrome-tab helper: relays the chrome-tab command's requests to its extension",
        "path": str(launcher),
        "type": "stdio",
        "allowed_origins": [f"chrome-extension://{HELPER_EXT_ID}/"],
    }
    nmh_dir().mkdir(parents=True, exist_ok=True)
    helper_manifest_path().write_text(json.dumps(manifest, indent=2) + "\n")
    version = json.loads((d / "extension" / "manifest.json").read_text())["version"]
    print(f"✓ helper {version} installed in {d}")
    print(f"✓ Chrome can start its host: {helper_manifest_path()}")
    running = helper_host()
    if running:
        try:
            helper_call("reload", timeout=3)
        except HelperError:
            pass
        print("✓ the running extension is reloading with these files (a few seconds)")
        return
    print(f"""
One step left, once, in the Chrome profile you use:
  1. open chrome://extensions and switch on “Developer mode” (top right)
  2. click “Load unpacked” and choose:  {d / 'extension'}
     (in the file picker, ⇧⌘G then paste that path)
Then check it with:  chrome-tab helper status""")


def helper_status(args):
    d = helper_dir()
    m = helper_manifest_path()
    ok = True
    def line(good, text):
        nonlocal ok
        ok = ok and good
        print(f"{'✓' if good else '✗'} {text}")
    installed = m.exists() and (d / "host").exists() and (d / "extension" / "manifest.json").exists()
    if not installed:
        print("✗ not installed. Install:  chrome-tab helper install")
        sys.exit(1)
    try:
        path = json.loads(m.read_text()).get("path")
    except ValueError:
        path = None
    line(path == str(d / "host"), f"host registered with Chrome ({m})")
    src_v = json.loads((HELPER_SRC / "extension" / "manifest.json").read_text())["version"] \
        if (HELPER_SRC / "extension" / "manifest.json").exists() else None
    inst_v = json.loads((d / "extension" / "manifest.json").read_text())["version"]
    line(src_v in (None, inst_v), f"extension files {inst_v} in {d / 'extension'}"
         + ("" if src_v in (None, inst_v) else f" — this chrome-tab ships {src_v}: chrome-tab helper install"))
    host = helper_host()
    if not host:
        line(False, "not running. If you haven't yet: chrome://extensions → Developer mode → "
                    f"Load unpacked → {d / 'extension'}. If you have: check it's switched on.")
        sys.exit(1)
    ext = host.get("extension") or {}
    t0 = time.monotonic()
    try:
        pong = helper_call("ping", timeout=3)
    except HelperError as e:
        pong = None
        line(False, f"host {host.get('pid')} runs, but the extension didn't answer: {e}")
    if pong:
        line(True, f"running: extension {pong.get('version')} ({pong.get('extensionId')}), host pid "
                   f"{host.get('pid')}, Chrome pid {host.get('chrome_pid')}, round trip "
                   f"{(time.monotonic() - t0) * 1000:.0f} ms")
        if pong.get("version") != inst_v:
            line(False, f"Chrome is running extension {pong.get('version')}, the files are {inst_v}: "
                        "reload it in chrome://extensions")
    sys.exit(0 if ok else 1)


def helper_uninstall(args):
    d = helper_dir()
    m = helper_manifest_path()
    if m.exists():
        m.unlink()
        print(f"✓ removed {m}")
    launcher = d / "host"
    if launcher.exists() and LAUNCHER_HEAD in launcher.read_text(errors="ignore"):
        shutil.rmtree(d)
        print(f"✓ removed {d}")
    elif d.exists():
        print(f"left {d} alone: it doesn't look like the helper's folder")
    print("Last step: remove “chrome-tab helper” in chrome://extensions.")


# ------------------------------------------------ Claude-in-Chrome tab mover
#
# The Claude-in-Chrome extension makes each session's tab group in whichever window had
# focus last (chrome.windows.getLastFocused) and has no setting for it. A PostToolUse hook
# on its tools reads the group the tool just reported and, if it's brand new, has the
# helper move the whole group into the browse window. tabGroups.move keeps the group's id
# (verified in Chrome for Testing 153), so the session's stored group stays valid even if
# Claude-in-Chrome's own listener isn't running. When the listener is running, it sees
# the tab leave its group for a moment (groupId -1, also verified) and regroups it in
# the new window — which also works, because it rotates the session's stored id.

DEFAULT_BROWSE = None       # None: the home window (chrome-tab home)
CIC_TOOLS = re.compile(r"^mcp__claude-in-chrome__(tabs_context_mcp|navigate|browser_batch)$")
CIC_FRONT_LOADED = re.compile(r"Tab context \(from front-loaded tabs_context_mcp\):\n(\{.*\})")
CIC_BATCH_LINE = re.compile(r"^\[tabs_context_mcp\] (\{.*\})$", re.M)


def browse_window_name():
    env = os.environ.get("CHROME_TAB_BROWSE_WINDOW", "").strip()
    if env:
        return env
    v = read_config().get("browse_window")
    return v.strip() if isinstance(v, str) and v.strip() else (DEFAULT_BROWSE or home_window_name())


def browse_target(event, windows, ext):
    """(window, anchor group id or None, why) for a session's browsing group.

    2026-09-17, the user's pick: beside the group this session's pages went to (the binding
    written by `chrome-tab open`), else the browse window (default: the home window).
    """
    b = read_binding(event.get("session_id")) if event.get("session_id") else None
    if b and b.get("group") and b.get("window_name"):
        w = next((w for w in windows if w["given_name"].lower() == b["window_name"].lower()), None)
        if w:
            gid = None
            for x in ext or []:
                if str(x["id"]) == w["id"]:
                    gid = next((g["id"] for g in x.get("groups") or [] if g["title"] == b["group"]), None)
            return w, gid, f"beside this session's “{b['group']}” group in “{w['given_name']}”"
    name = browse_window_name()
    w = next((w for w in windows if w["given_name"].lower() == name.lower()), None)
    return w, None, f"into the “{name}” window"


def _response_texts(resp):
    """The text blocks of a tool_response: MCP tools give a list of content blocks."""
    if isinstance(resp, str):
        return [resp]
    if isinstance(resp, dict):
        resp = resp.get("content", [resp])
    out = []
    for b in resp if isinstance(resp, list) else []:
        if isinstance(b, str):
            out.append(b)
        elif isinstance(b, dict) and b.get("type") == "text":
            out.append(b.get("text") or "")
    return out


def claude_groups_in(resp):
    """Every tab-context object ({availableTabs, tabGroupId, …}) a Claude-in-Chrome result reports.

    Three shapes carry one (seen across 191 calls, 2026-09-17): a whole text block that is
    the JSON (tabs_context_mcp); a "Tab context (from front-loaded tabs_context_mcp):" block
    that Claude Code appends to a navigate without a tabId; and "[tabs_context_mcp] {…}"
    lines inside a browser_batch result.
    """
    found = {}
    for text in _response_texts(resp):
        candidates = [text.strip()] + CIC_FRONT_LOADED.findall(text) + CIC_BATCH_LINE.findall(text)
        for c in candidates:
            if not c.startswith("{"):
                continue
            try:
                obj = json.loads(c)
            except ValueError:
                continue
            if (isinstance(obj, dict) and isinstance(obj.get("availableTabs"), list)
                    and isinstance(obj.get("tabGroupId"), int)):
                found[obj["tabGroupId"]] = obj
    return list(found.values())


def fresh_groups(resp):
    """The reported groups that look brand new: one tab, and no tab of it selected yet."""
    return [g for g in claude_groups_in(resp)
            if len(g["availableTabs"]) == 1 and "selectedTabId" not in g
            and isinstance(g["availableTabs"][0].get("tabId"), int)]


def hook_log(msg):
    try:
        d = helper_dir()
        d.mkdir(parents=True, exist_ok=True)
        with (d / "hook.log").open("a") as f:
            f.write(f"{time.strftime('%Y-%m-%d %H:%M:%S')}  {msg}\n")
    except Exception:
        pass


def _moved_record():
    f = helper_dir() / "moved.json"
    try:
        data = json.loads(f.read_text())
    except Exception:
        data = {}
    cutoff = time.time() - 7 * 86400
    return f, {k: v for k, v in data.items() if isinstance(v, (int, float)) and v > cutoff}


def claim_claude_tab(event):
    """Move a brand-new Claude-in-Chrome session group into the browse window.

    Returns a line for the session (or None). Guardrails: only a group the tool just
    reported, holding exactly that one tab, only once per tab (a group the user drags
    elsewhere afterwards stays there), never an active tab, never a window created.
    """
    groups = fresh_groups(event.get("tool_response"))
    if not groups:
        return None
    host = helper_host()
    if not host:
        hook_log(f"skip: helper not running ({event.get('tool_name')})")
        return ("chrome-tab's helper isn't running, so this session's Chrome tab group stayed "
                "in the window Chrome last had focus in (chrome-tab helper status).")
    windows = list_windows(host.get("chrome_pid"))
    try:
        ext = helper_call("windows") or []
    except HelperError:
        ext = []
    target, anchor, why = browse_target(event, windows, ext)
    name = target["given_name"] if target else browse_window_name()
    record_file, moved = _moved_record()
    for g in groups:
        tab_id = g["availableTabs"][0]["tabId"]
        if str(tab_id) in moved:
            continue
        try:
            info = helper_call("tab", timeout=3, tabId=tab_id)
        except HelperError as e:
            hook_log(f"skip tab {tab_id}: {e}")
            continue
        grp = (info or {}).get("group")
        if not grp or grp["id"] != g["tabGroupId"] or grp.get("tabs") != 1:
            hook_log(f"skip tab {tab_id}: not a lone tab in reported group {g['tabGroupId']} ({grp})")
            continue
        here = next((w for w in windows if w["id"] == str(info["windowId"])), None)
        here_name = (here or {}).get("given_name") or f"window {info['windowId']}"
        if target is None:
            hook_log(f"skip tab {tab_id}: no window named {name!r}; it is in {here_name!r}")
            return (f"No Chrome window named “{name}” is open, so this session's tab group stayed in "
                    f"“{here_name}”. Tell the user in one line; naming a window “{name}” fixes it.")
        if str(info["windowId"]) == target["id"]:
            moved[str(tab_id)] = time.time()
            continue
        if info.get("active"):
            hook_log(f"skip tab {tab_id}: it is the tab {here_name!r} is showing")
            continue
        t0 = time.monotonic()
        guard = FocusGuard()
        with guard:
            r = helper_call("moveGroup", timeout=5, groupId=g["tabGroupId"], windowId=int(target["id"]),
                            afterGroupId=anchor)
            # Wait until the tab sits in the target window inside a group again (Claude-in-
            # Chrome may regroup it), so the session's next step finds it in place.
            settled = None
            for _ in range(30):
                now = helper_call("tab", timeout=2, tabId=tab_id) or {}
                if str(now.get("windowId")) == target["id"] and now.get("group"):
                    settled = now
                    break
                time.sleep(0.1)
            guard.done()
        moved[str(tab_id)] = time.time()
        try:
            record_file.write_text(json.dumps(moved))
        except Exception:
            pass
        ms = (time.monotonic() - t0) * 1000
        hook_log(f"moved tab {tab_id} group {g['tabGroupId']} {here_name!r} → {name!r} ({why}) in {ms:.0f} ms; "
                 f"events {r.get('events')}; now group {(settled or {}).get('group')}; "
                 f"{guard.describe() or 'guard off (user in Chrome)'}")
        return (f"chrome-tab moved this session's Chrome tab group (tab {tab_id}) from “{here_name}” "
                f"{why}.")
    try:
        record_file.write_text(json.dumps(moved))
    except Exception:
        pass
    return None


def cmd_hook(args):
    try:
        event = json.load(sys.stdin)
    except Exception:
        return
    if not CIC_TOOLS.match(str(event.get("tool_name", ""))):
        return
    try:
        msg = claim_claude_tab(event)
    except SystemExit:
        return
    except Exception as e:            # a hook must never break the tool call
        hook_log(f"error: {e!r}")
        return
    if msg:
        print(json.dumps({"hookSpecificOutput": {"hookEventName": "PostToolUse",
                                                 "additionalContext": msg}}))


def cmd_helper(args):
    {"install": helper_install, "status": helper_status, "uninstall": helper_uninstall}[args.action](args)


def find_tab_window(tab_id, chrome_pid=None):
    """(window dict, tab info or None) for a tab id, or (None, None)."""
    info = None
    try:
        info = helper_call("tab", timeout=3, tabId=int(tab_id))
    except HelperError:
        return None, None
    windows = list_windows(chrome_pid)
    if info:
        w = next((w for w in windows if w["id"] == str(info["windowId"])), None)
        return w, info
    # No helper: ask AppleScript, read-only (extension and AppleScript tab ids are the same).
    raw = osa(f"""
tell application "Google Chrome"
  repeat with i from 1 to count of windows
    if (id of every tab of window i) contains ({int(tab_id)} as integer) then return (id of window i) as text
  end repeat
  return ""
end tell""")
    w = next((w for w in windows if w["id"] == raw.strip()), None)
    return w, None


def cmd_where(args):
    host = helper_host()
    w, info = find_tab_window(args.tab_id, host.get("chrome_pid") if host else None)
    if not w:
        die(f"no open tab has id {args.tab_id}")
    name = w["given_name"] or f"(unnamed window {w['id']})"
    extra = ""
    if info and info.get("group"):
        extra = f", group “{info['group']['title']}”"
    print(f"tab {args.tab_id} is in window “{name}”{extra}")


def cmd_move(args):
    host = helper_host()
    if not host:
        die("moving a tab needs the chrome-tab helper (chrome-tab helper status). "
            "AppleScript can't do it: its move closes the tab and opens a blank one.")
    chrome_pid = host.get("chrome_pid")
    windows = list_windows(chrome_pid)
    dest = resolve_window(args.window, windows, titles=False)
    if not dest:
        die(f"no window named “{args.window}” is open (names: chrome-tab list)")
    try:
        info = helper_call("tab", timeout=3, tabId=int(args.tab_id))
    except HelperError as e:
        die(f"no open tab has id {args.tab_id} ({e})")
    if str(info["windowId"]) == dest["id"]:
        print(f"tab {args.tab_id} is already in “{dest['given_name']}”")
        return
    if info.get("active") and not args.force:
        die(f"tab {args.tab_id} is the tab its window is showing, so moving it would change what "
            "that window shows. Pass --force to move it anyway.")
    guard = FocusGuard()
    with guard:
        helper_call("move", timeout=5, tabId=int(args.tab_id), windowId=int(dest["id"]))
        guard.done()
    print(f"✓ moved tab {args.tab_id} to “{dest['given_name']}”")
    what = guard.describe()
    if what:
        print(f"  ({what})")


def place_tab(win_id, url, looking, select, args):
    """Put `url` in window `win_id`, reusing an open copy unless the user is reading it.

    Returns one of: 'added' | 'reused' | 'added-beside'.

    Which tab the window shows is left exactly as it was unless `select`
    (--select, implied by --activate). AppleScript's `make new tab` selects the
    tab it makes, so the previously active tab is put straight back; the
    extension path never selects in the first place.

    `looking` means the user has this very window in front of them right now
    (Chrome is the frontmost app and this is its front window). It decides one
    thing: whether an open copy may be reloaded under them.

    'added-beside' is the case where the page is already open AND it is the tab
    the user is looking at this second. Reloading would scroll them back to the
    top and collapse any <details> they had opened, mid-read. So their copy is
    left untouched and the new render goes in a tab beside it — behind, not in
    front. (Form answers are never at risk either way — decision-forms-html
    persists them to localStorage on every keystroke and restores them on load.)
    """
    info = osa(FIND_TAB_SCRIPT, win_id, url)
    if info.startswith("ERR"):
        die(f"could not inspect window ({info})")
    idx_s, active_s = info.split("|")
    idx, active_idx = int(idx_s), int(active_s)

    def add():
        osa(ADD_SCRIPT, win_id, url)
        if not select and active_idx > 0:
            osa(SELECT_TAB_SCRIPT, win_id, active_idx)   # keep their tab in front

    if args.no_reuse or idx == 0:     # not open here yet
        add()
        return "added"

    if looking and idx == active_idx and not args.force_reload:
        add()
        return "added-beside"

    osa(RELOAD_SCRIPT, win_id, str(idx), "1" if select else "0")
    return "reused"


def check_switch(reply, select):
    """Did this open change which tab the window shows, when it shouldn't have?

    The helper reports the showing tab before and after (0.5.0). A True here is a
    bug, not a style choice: the page took over a tab strip the user owns. Older
    extensions don't send the fields — then there is nothing to measure, and the
    caller says so instead of promising.
    """
    if not isinstance(reply, dict) or "showing" not in reply:
        return None                      # extension older than this chrome-tab
    if select:
        return False
    return reply.get("showing") != reply.get("showingBefore")


FOCUS_LOG = Path.home() / ".claude" / "chrome-tab-focus.log"


def cmd_open(args):
    if args.new_window and not args.window:
        die("--new-window needs --window NAME, so the window can be found again")
    urls = [to_url(t) for t in args.targets]
    # Showing the page is opt-in. Everything else opens in the background, in its
    # group, and waits there: which tab a window shows belongs to the user.
    select = args.select or args.activate
    switched = []                       # per-url: did the window's shown tab change?
    old_helper = False
    # Who is in front before we touch anything — the guard records it, and it is
    # measured again at the end so the closing line is a reading, not a promise.
    guard = FocusGuard(enabled=not args.activate)
    before_name = guard.name
    chrome_is_front = guard.bid == CHROME_BID

    # The helper, when it runs, does the navigating: an extension adds a background tab
    # without asking macOS to raise Chrome, and it can make tab groups. Its host also
    # knows which Chrome process runs it, so names are read from that process.
    host = helper_host()
    chrome_pid = host.get("chrome_pid") if host else None
    notes = []

    # --- pick the target window -------------------------------------------
    windows = list_windows(chrome_pid)
    # What the user sees on top inside Chrome. Chrome's `front window` can be a
    # minimized one (observed 2026-09-03), so take the first that isn't.
    visible_front = next((w["id"] for w in windows if not w["minimized"]), None)
    wanted_name = args.window or os.environ.get("CLAUDE_CHROME_WINDOW")
    binding = read_binding() or {}
    if not wanted_name and not binding.get("group") and binding.get("window_name"):
        wanted_name = binding.get("window_name")          # a binding from before 0.4.0
    ext = None
    if host:
        try:
            ext = helper_call("windows") or []
        except HelperError as e:
            notes.append(f"the helper didn't answer ({e}), so AppleScript was used")
    plan = plan_placement(windows, ext, wanted_name, args.group, binding, args.targets,
                          home_window_name(), args.new_window)
    target, create_name, fell_back = plan["window"], plan["create_name"], plan["fell_back"]
    group = plan["group"]
    bridge = ext is not None and (target is None or any(str(w["id"]) == target["id"] for w in ext))
    if ext is not None and not bridge:
        notes.append("the helper can't see that window (another Chrome profile?), "
                     "so it was opened by AppleScript")
        group = None
    if ext is None and (args.group or fell_back):
        notes.append(f"not grouped as “{plan['topic']}”: tab groups need the helper extension "
                     "(chrome-tab helper status)")

    created = False
    results = []                        # (url, action, group-info or None)
    was_minimized = looking = used_applescript = False
    with guard:
        if target is None:
            wid = None
            if bridge:
                try:
                    r = helper_call("createWindow", timeout=15, url=urls[0], group=group,
                                    color=args.color)
                    if r:
                        wid = str(r["windowId"])
                        name_window(wid, create_name, chrome_pid)
                        results.append((urls[0], "created", r.get("group")))
                except HelperError as e:
                    notes.append(f"the helper couldn't make the window ({e}); AppleScript did")
            if wid is None:
                wid = osa(CREATE_SCRIPT, create_name, urls[0])
                results.append((urls[0], "created", None))
                used_applescript = True
            created = True
            target = {"id": wid, "given_name": create_name, "index": 0, "title": "", "tabs": 1,
                      "minimized": False}
            urls = urls[1:]

        was_minimized = bool(target.get("minimized"))
        # `looking` decides one thing only: whether an open copy of this page may be
        # reloaded under the user. Selection is not a function of where they are —
        # since 0.5.0 a page never takes over a window's tab strip unless asked.
        looking = (chrome_is_front and target["id"] == visible_front
                   and not was_minimized and not args.activate)
        for u in urls:
            if bridge:
                try:
                    r = helper_call("open", timeout=15, url=u, windowId=int(target["id"]),
                                    group=group, color=args.color, reuse=not args.no_reuse,
                                    looking=looking, forceReload=args.force_reload,
                                    select=select)
                    if r:
                        results.append((u, r["action"], r.get("group")))
                        switched.append(check_switch(r, select))
                        if switched[-1] is None and not select and not old_helper:
                            # 0.4.x picked selection from `looking`, so it still hands a
                            # window over to the page. Say so, with the one-line fix.
                            old_helper = True
                            notes.append("the loaded helper extension is older than this "
                                         "chrome-tab, so a page can still take over a window's "
                                         "tab strip — run: chrome-tab helper install")
                        continue
                    notes.append("the helper stopped answering; AppleScript opened the rest")
                except HelperError as e:
                    if "file" in str(e).lower() and "access" in str(e).lower():
                        notes.append("the helper may not open local files: in chrome://extensions → "
                                     "chrome-tab helper → Details, turn on “Allow access to file URLs”")
                    notes.append(f"the helper refused ({e}); AppleScript opened it")
                bridge = False
            results.append((u, place_tab(target["id"], u, looking, select, args), None))
            used_applescript = True

        navigated = created or any(a in ("added", "added-beside") for _, a, _ in results)
        if navigated and not args.activate:
            if used_applescript:
                # AppleScript's `set URL` shows the window, which raises it inside Chrome
                # and de-minimizes it. Put both back before the user can notice.
                if visible_front and visible_front != target["id"]:
                    osa(RAISE_SCRIPT, visible_front)
                if was_minimized:
                    osa(MINIMIZE_SCRIPT, target["id"])
            else:
                # The extension adds tabs in the background; check rather than assume.
                settle_after_helper(visible_front, target, was_minimized, chrome_pid)
        # Reloads never activate Chrome (measured), so don't make them wait.
        guard.done(tail=None if navigated else 0)

    # The delayed second show can reorder windows again; check once more.
    if navigated and not args.activate and visible_front and visible_front != target["id"]:
        now = list_windows(chrome_pid)
        front_now = next((w["id"] for w in now if not w["minimized"]), None)
        if front_now and front_now != visible_front:
            osa(RAISE_SCRIPT, visible_front)

    if args.bind and args.window:
        write_binding(target["given_name"] or args.window)

    if args.activate:
        osa(ACTIVATE_SCRIPT, target["id"])

    # --- report ------------------------------------------------------------
    label = target["given_name"] or f"window {target['id']}"
    groups = [g for _, _, g in results if g]
    where = f"Chrome window “{label}”"
    if groups:
        g = groups[-1]
        fresh = any(x.get("created") for x in groups)
        where += f", group “{g['title']}”" + (f" (new, {g['color']})" if fresh else "")
    if fell_back and groups:
        print(f"no window named “{wanted_name}” is open, so “{plan['topic']}” is the tab group "
              f"(a new window only with --new-window)")
    elif fell_back:
        print(f"no window named “{wanted_name}” is open, so this went to the home window "
              f"“{label}” (a new window only with --new-window; names: chrome-tab list)")
    if created:
        print(f"✓ created {where} · {len(args.targets)} tab(s)")
    n = lambda kind: sum(1 for _, a, _ in results if a == kind)
    bits = []
    if n("added"):
        bits.append(f"{n('added')} new tab(s)")
    if n("reused"):
        bits.append(f"{n('reused')} reloaded in place")
    if n("added-beside"):
        bits.append(f"{n('added-beside')} opened in a new tab behind the one you're reading")
    if bits or not created:
        print(f"✓ {' + '.join(bits) or 'nothing to do'} in {where}")
    if n("added-beside"):
        print("  (left your open copy untouched — pass --force-reload to override)")
    if select:
        print("  (brought forward and shown, as asked)" if args.activate
              else "  (shown in its window, as asked — --select)")
    elif n("added") or n("added-beside") or n("reused"):
        measured = [x for x in switched if x is not None]
        if any(measured):
            # The window changed what it was showing without being asked. Measured,
            # not assumed, so this line is a bug report the user can act on.
            print("  ⚠ that window switched to this page on its own — that is a chrome-tab "
                  "bug; tell Claude")
            try:
                with FOCUS_LOG.open("a") as fh:
                    fh.write(f"{time.strftime('%Y-%m-%d %H:%M:%S')}  tab-switch  a page took over "
                             f"the shown tab of “{label}” without --select\n")
            except Exception:
                pass
        elif measured:
            print(f"  (in the background — “{label}” still shows the tab it did)")
        elif used_applescript:
            # AppleScript selects the tab it makes; place_tab put theirs straight back.
            print("  (in the background — the tab that window showed was put straight back)")
        else:
            print("  (in the background)")
    if groups:
        g = groups[-1]
        if plan["followed"]:
            print(f"  (followed the group “{g['title']}” into “{label}”)")
        if group_score(plan["topic"], g["title"]) == 1:
            print(f"  (matched “{plan['topic']}” to the group “{g['title']}”)")
        if any(x.get("created") for x in groups):
            src = plan["topic_source"]
            others = ", ".join(plan["others"][:14]) or "none"
            print(f"  (new group, named from {src}; other groups in this window: {others} — "
                  f"re-run with --group to use one of those instead)")
        write_binding(label, g["title"])
    if was_minimized:
        print("  note: that window is minimized — the tab is there when you restore it.")
    for note in notes:
        print(f"  note: {note}")
    via = "helper" if not used_applescript else "AppleScript"
    if not args.activate:
        after_name = front_app()[0]
        what = guard.describe()
        if what:
            print(f"  ({what})")
        note = slow_path_note() if guard.enabled else None
        if note:
            print(f"  {note}  (chrome-tab doctor lists everything like this)")
        if guard.spans:
            # Evidence for the record: how often Chrome grabs the front and how
            # fast it is undone. Kind "guard" so focus-log-report.py doesn't
            # count it as a steal.
            try:
                with FOCUS_LOG.open("a") as f:
                    f.write(f"{time.strftime('%Y-%m-%d %H:%M:%S')}  guard  {what} "
                            f"while opening in “{label}”{' (new window)' if created else ''} "
                            f"via {via}; user was in {before_name}\n")
            except Exception:
                pass
        if after_name == before_name or before_name is None:
            print("  (focus left where it was)")
        else:
            # Until 2026-08-20 this line was printed unconditionally, which made
            # chrome-tab's own output useless for telling whether a focus change
            # seen by the restore-focus trial was chrome-tab's doing. Now it is
            # measured, and a deviation goes into the same log the trial reads.
            print(f"  ⚠ focus moved from {before_name} to {after_name} during this call — "
                  "that is a chrome-tab bug; tell Claude")
            try:
                with FOCUS_LOG.open("a") as f:
                    f.write(f"{time.strftime('%Y-%m-%d %H:%M:%S')}  chrome-tab  moved focus "
                            f"{before_name} → {after_name} while opening in “{label}”"
                            f"{' (new window)' if created else ''} via {via}\n")
            except Exception:
                pass


def settle_after_helper(visible_front, target, was_minimized, chrome_pid):
    """After the extension navigated: undo a window raise or de-minimize only if one happened."""
    now = list_windows(chrome_pid)
    front_now = next((w["id"] for w in now if not w["minimized"]), None)
    if visible_front and visible_front != target["id"] and front_now == target["id"]:
        osa(RAISE_SCRIPT, visible_front)
    if was_minimized:
        t = next((w for w in now if w["id"] == target["id"]), None)
        if t and not t["minimized"]:
            osa(MINIMIZE_SCRIPT, target["id"])


# ----------------------------------------------------------------------- main


def chrome_installed():
    return os.path.isdir("/Applications/Google Chrome.app") or os.path.isdir(
        os.path.expanduser("~/Applications/Google Chrome.app"))


def require_macos_chrome():
    """This tool drives Chrome through AppleScript, which exists only on macOS."""
    if sys.platform != "darwin":
        die("chrome-tab requires macOS — it drives Chrome via AppleScript (osascript).")
    if not chrome_installed():
        die("Google Chrome not found in /Applications (or ~/Applications).")


def cmd_doctor(args):
    """Report the things that otherwise fail silently, each with its fix.

    Exit 0 when everything is in order, 1 when any line is marked ✗ — so install.sh
    can end with it and a hook could run it with --quiet.
    """
    import platform
    import shutil

    me = Path(__file__).resolve()
    installer = me.parent / "install.sh"
    fix_path = f'sh "{installer}"'
    lines = []
    problems = 0

    def ok(label, text):
        lines.append(f"  {label:<10} {text}")

    def bad(label, text):
        nonlocal problems
        problems += 1
        lines.append(f"✗ {label:<10} {text}")

    ok("running", f"{me}  ({__version__})")

    inst = installed_copy()
    if inst is None:
        ok("installed", "no plugin copy on this Mac — this is a source checkout")
    elif inst.resolve() == me:
        ok("installed", "this file is the installed plugin copy (installed_plugins.json)")
    else:
        ok("installed", f"plugin copy {inst}  ({version_of(inst) or '?'}); you are running "
                        f"a source checkout, which wins")

    bindir = Path.home() / ".local" / "bin"
    entry = bindir / "chrome-tab"
    if not (entry.exists() or entry.is_symlink()):
        bad("command", f"{entry} does not exist — install it:  {fix_path}")
    else:
        try:
            head = entry.read_text(errors="ignore")[:400]
        except Exception:
            head = ""
        if LAUNCHER_MARK in head:
            ok("command", f"{entry} is a launcher — it runs the installed plugin copy, so "
                          f"`claude plugin update` is enough; never re-run install.sh")
        else:
            real = entry.resolve()
            if real == me or (inst is not None and real == inst.resolve()):
                ok("command", f"{entry} → {real}")
            elif version_of(real) == __version__:
                ok("command", f"{entry} → {real}  (another {__version__} copy)")
            else:
                bad("command", f"{entry} → {real}  ({version_of(real) or '?'}) is STALE — "
                               f"this copy is {__version__}. Fix:  {fix_path}")
    found = shutil.which("chrome-tab")
    if found and Path(found).resolve() != entry.resolve() and Path(found) != entry:
        bad("shadowed", f"PATH finds {found} before {entry} — remove or reorder")

    on_path = str(bindir) in os.environ.get("PATH", "").split(":")
    if on_path:
        ok("PATH", f"{bindir} is on PATH")
    else:
        bad("PATH", f"{bindir} is not on PATH — add to ~/.zshenv:  "
                    f"export PATH=\"$HOME/.local/bin:$PATH\"")

    pyv = platform.python_version()
    if _appkit():
        ok("python", f"{sys.executable} {pyv} — PyObjC present (focus guard polls every 3 ms)")
    else:
        bad("python", f"{sys.executable} {pyv} — PyObjC missing: the focus guard falls back to "
                      f"50 ms polls + `open -b`, so a jump can show for a frame or two. "
                      f"Fix:  {pip_hint()}")

    if helper_manifest_path().exists():
        host = helper_host()
        if host:
            ext = host.get("extension") or {}
            ok("helper", f"running (extension {ext.get('version', '?')}, Chrome pid {host.get('chrome_pid')})"
                         " — tab groups on, pages open without AppleScript navigation")
        else:
            bad("helper", "installed but not running — load it once: chrome://extensions → Developer "
                          f"mode → Load unpacked → {helper_dir() / 'extension'}  (chrome-tab helper status)")
    else:
        ok("helper", "not installed (optional: tab groups, quieter opens) — chrome-tab helper install")

    if sys.platform != "darwin":
        bad("macOS", "not macOS — chrome-tab drives Chrome via AppleScript")
    elif not chrome_installed():
        bad("Chrome", "Google Chrome not found in /Applications or ~/Applications")
    else:
        ok("Chrome", "Google Chrome found")

    if not args.quiet:
        print(f"chrome-tab doctor ({__version__})")
        print("\n".join(lines))
    elif problems:
        print("\n".join(l for l in lines if l.startswith("✗")))
    if problems:
        if not args.quiet:
            print(f"{problems} thing(s) to fix.")
        sys.exit(1)
    if not args.quiet:
        print("All good.")


def main():
    forward_if_stale()
    p = argparse.ArgumentParser(
        prog="chrome-tab",
        description="Open pages in a chosen Chrome window without stealing focus.",
    )
    p.add_argument("--version", action="version", version=f"chrome-tab {__version__}")
    sub = p.add_subparsers(dest="cmd", required=True)

    pl = sub.add_parser("list", help="list Chrome windows by name")
    pl.add_argument("--json", action="store_true")
    pl.set_defaults(func=cmd_list)

    po = sub.add_parser("open", help="open url(s)/file(s) in a chosen window")
    po.add_argument("targets", nargs="+")
    po.add_argument("--window", "-w", help="target window given-name (or #index)")
    po.add_argument("--group", "-g", help="tab group to put it in (needs the helper)")
    po.add_argument("--color", choices=["grey", "blue", "red", "yellow", "green", "pink", "purple",
                                        "cyan", "orange"], help="colour for a new group")
    po.add_argument("--new-window", action="store_true",
                    help="make a new window (named via --window) — only when the user asks")
    po.add_argument("--activate", action="store_true",
                    help="bring Chrome forward and show the page (implies --select)")
    po.add_argument("--select", action="store_true",
                    help="show the page in its window (default: it waits in the background)")
    po.add_argument("--no-reuse", action="store_true", help="never reload an existing tab")
    po.add_argument("--force-reload", action="store_true",
                    help="reload in place even if the user is currently reading that tab")
    po.add_argument("--no-select", action="store_true",
                    help=argparse.SUPPRESS)      # the default since 0.5.0; kept so old calls run
    po.add_argument("--bind", action="store_true", help="remember this window for the session")
    po.set_defaults(func=cmd_open)

    pn = sub.add_parser("name", help="set a window's given name")
    pn.add_argument("selector")
    pn.add_argument("new_name")
    pn.set_defaults(func=cmd_name)

    pb = sub.add_parser("bind", help="bind this session to a window name")
    pb.add_argument("name")
    pb.set_defaults(func=cmd_bind)

    sub.add_parser("unbind", help="drop this session's binding").set_defaults(func=cmd_unbind)
    phl = sub.add_parser("helper", help="install / check / remove the companion extension")
    phl.add_argument("action", choices=["install", "status", "uninstall"])
    phl.set_defaults(func=cmd_helper)
    pw = sub.add_parser("where", help="which window holds a tab (by tab id)")
    pw.add_argument("tab_id")
    pw.set_defaults(func=cmd_where)
    pk = sub.add_parser("hook", help="PostToolUse hook entry points (see scripts/install-cic-hook.py)")
    pk.add_argument("kind", choices=["claude-in-chrome"])
    pk.set_defaults(func=cmd_hook)
    pm = sub.add_parser("move", help="move a tab into a named window (needs the helper)")
    pm.add_argument("tab_id")
    pm.add_argument("--window", "-w", required=True)
    pm.add_argument("--force", action="store_true", help="move it even if its window is showing it")
    pm.set_defaults(func=cmd_move)
    ph = sub.add_parser("home", help="show or set the home window (default “Claude sessions”)")
    ph.add_argument("name", nargs="?")
    ph.set_defaults(func=cmd_home)
    sub.add_parser("whoami", help="show this session's window binding").set_defaults(
        func=cmd_whoami
    )

    pd = sub.add_parser("doctor", help="check what fails silently: stale PATH entry, PyObjC, PATH")
    pd.add_argument("--quiet", action="store_true", help="print only what needs fixing")
    pd.set_defaults(func=cmd_doctor)

    args = p.parse_args()
    if args.cmd not in ("doctor", "home", "helper", "hook"):
        require_macos_chrome()
    args.func(args)


if __name__ == "__main__":
    main()
